# Postgres connection string (Neon/Supabase in production, local Postgres in dev)
DATABASE_URL="postgresql://user:password@localhost:5432/orbit"

# openssl rand -base64 32
AUTH_SECRET=""
# Only required in production if the deployment URL differs from Vercel's inferred one
NEXTAUTH_URL=""

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Authorized redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# resend.com API key, and a from-address on a domain verified in Resend
RESEND_API_KEY=""
EMAIL_FROM="Orbit <onboarding@yourdomain.com>"

# Upstash Redis (free tier) — REST credentials from the Upstash console
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Public app URL — the only NEXT_PUBLIC_ var in this app. Safe to expose: it's
# used client-side only to build absolute links (e.g. invite/share URLs) and
# carries no secret material.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
